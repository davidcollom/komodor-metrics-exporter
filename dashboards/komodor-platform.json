    {
      "id": 11,
      "title": "Active risks by check type, top 10 (all clusters)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
