{
  "uid": "komodor-hotspots",
  "title": "Komodor Hotspots",
  "tags": [
    "komodor"
  ],
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "top",
        "type": "custom",
        "label": "Top N",
        "query": "5,10,20,50",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "text": "5",
            "value": "5",
            "selected": false
          },
          {
            "text": "10",
            "value": "10",
            "selected": true
          },
          {
            "text": "20",
            "value": "20",
            "selected": false
          },
          {
            "text": "50",
            "value": "50",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "title": "Most active risks",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sort_desc(topk($top, sum by (cluster) (komodor_reliability_risks_active)))",
          "legendFormat": "{{cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "locale",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      }
    },
    {
      "id": 5,
      "title": "Most high-severity risks",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sort_desc(topk($top, sum by (cluster) (komodor_reliability_risks_active{severity=\"high\"})))",
          "legendFormat": "{{cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "locale",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      }
    },
    {
      "id": 6,
      "title": "Most open issues",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sort_desc(topk($top, sum by (cluster) (komodor_issues_open)))",
          "legendFormat": "{{cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "locale",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      }
    },
    {
      "id": 1,
      "title": "Cluster hotspots: risks and open issues (darker red = more)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (cluster) (komodor_reliability_risks_active{severity=\"high\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (cluster) (komodor_reliability_risks_active{severity=\"medium\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (cluster) (komodor_reliability_risks_active{severity=\"low\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "sum by (cluster) (komodor_issues_open{type=\"availability\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "sum by (cluster) (komodor_issues_open{type=\"failed-deploy\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "sum by (cluster) (komodor_issues_open{type=\"node-issue\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "sum by (cluster) (komodor_issues_open{type=\"pvc-issue\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "sum by (cluster) (komodor_issues_open{type=\"workflow-issue\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            },
            "align": "right"
          },
          "min": 0,
          "unit": "locale",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cluster"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "High risks",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "cluster",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "Value #A": "High risks",
              "Value #B": "Medium risks",
              "Value #C": "Low risks",
              "Value #D": "availability",
              "Value #E": "failed-deploy",
              "Value #F": "node-issue",
              "Value #G": "pvc-issue",
              "Value #H": "workflow-issue"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Risk heat over time by cluster (top $top)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk($top, sum by (cluster) (komodor_reliability_risks_active))",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "fill": "dark-orange",
          "scale": "linear",
          "steps": 64,
          "reverse": false
        },
        "yAxis": {
          "axisPlacement": "left"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false
        },
        "showValue": "never"
      }
    },
    {
      "id": 3,
      "title": "Open issues over time by cluster (top $top)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk($top, sum by (cluster) (komodor_issues_open))",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
